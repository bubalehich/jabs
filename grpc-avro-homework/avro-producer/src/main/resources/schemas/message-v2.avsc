{
  "type": "record",
  "name": "Message",
  "namespace": "io.github.bubalehich.avro",
  "fields": [
    {"name": "id", "type": "string"},
    {"name": "text", "type": "string"},
    {"name": "author", "type": "string", "default": "anonymous"},
    {"name": "sentAt", "type": {"type": "long", "logicalType": "timestamp-millis"}, "default": 0}
  ]
}
